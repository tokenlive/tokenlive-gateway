# TokenLive Gateway environment variables
# Copy this file to .env and replace placeholder values before running locally.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Config file loaded by pkg/config. Leave empty to use the caller-provided default.
APP_CONF=config/local.yml

# Gateway API key HMAC pepper. Must match tokenlive-admin GATEWAY_API_KEY_PEPPER.
# Generate with: openssl rand -base64 32
GATEWAY_API_KEY_PEPPER=change_me_base64_32_bytes

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Leave REDIS_ADDR empty to disable Redis-backed features in local-only mode.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# ClickHouse
# -----------------------------------------------------------------------------

# Leave CLICKHOUSE_ADDR empty when access_log.clickhouse.enabled is false.
CLICKHOUSE_ADDR=
CLICKHOUSE_DATABASE=tokenlive
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Gateway Sync / Admin
# -----------------------------------------------------------------------------

# GATEWAY_CONFIG_SOURCE:
#   local: read model and policy config from local YAML
#   redis: read synced config from Redis
#   http: poll tokenlive-admin
GATEWAY_CONFIG_SOURCE=local

# GATEWAY_STATE_STORE:
#   memory: in-process state
#   redis: shared runtime state such as rate limits and circuit breakers
GATEWAY_STATE_STORE=memory

# Required when GATEWAY_CONFIG_SOURCE=http.
ADMIN_SERVER_URL=

# Development-only escape hatch for self-signed/local HTTPS admin endpoints.
ADMIN_TLS_SKIP_VERIFY=false

# Required when syncing with tokenlive-admin.
GATEWAY_SYNC_TOKEN=

# -----------------------------------------------------------------------------
# OpenTelemetry Metrics
# -----------------------------------------------------------------------------

OTEL_ENABLED=false
OTEL_ENDPOINT=
