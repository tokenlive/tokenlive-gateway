{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Gateway",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/server/main.go",
            "env": {},
            "args": [
                "-conf",
                "${workspaceFolder}/config/local.yml"
            ],
            "showLog": true,
            "buildFlags": "-v",
            "output": "${workspaceFolder}/bin/server",
            "cwd": "${workspaceFolder}"
        },
    ]
}